# Тонкий слой поверх уже собранного nav2:jazzy: виртуальный экран для RViz.
# Полный Dockerfile при следующей пересборке ставит те же пакеты сам.
FROM nav2:jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        python3-websockify \
        openbox \
        x11-utils \
    && rm -rf /var/lib/apt/lists/*

# zeroconf — поиск внешней камеры в сети по mDNS, без прописывания адреса.
RUN pip3 install --no-cache-dir --break-system-packages zeroconf

# Пакеты, которые pip поставил от root, остаются нечитаемыми для uid 1000.
# Коварно это тем, что импорт не падает: каталог без прав выглядит для Python
# пустым namespace-пакетом, `import requests` проходит, а `requests.get`
# которого нет, всплывает уже в работе. Те же пять пакетов и те же права,
# что в полном Dockerfile.
RUN for pkg in certifi charset_normalizer requests idna urllib3; do \
      find /usr/local/lib/python3.12/dist-packages -maxdepth 1 -type d \
        \( -name "$pkg" -o -name "$pkg-*.dist-info" \) \
        -exec chgrp -R 1000 {} + -exec chmod -R g+rX {} +; \
    done
