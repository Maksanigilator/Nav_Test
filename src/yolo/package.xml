<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo</name>
  <version>0.1.0</version>
  <description>YOLO-детектор: MJPEG-поток с Raspberry Pi -> детекции + поза робота в момент кадра</description>
  <maintainer email="skvortsov.maksim.2024@gmail.com">maks</maintainer>
  <license>MIT</license>

  <!-- Пакет ament_cmake, а не ament_python: нужен rosidl для генерации
       yolo/msg/FrameDetections.msg. Сам узел — обычный python-скрипт. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Типы, из которых собрано FrameDetections.msg -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- cv2/numpy/requests приезжают из pip, ultralytics туда же:
       см. блок "YOLO" в docker/Dockerfile. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
