<?xml version="1.0" ?>
<!-- Ровная площадка для проверки езды. Ни стен, ни препятствий: здесь
     проверяется только меканум-физика, а не навигация. Лабиринт лежит
     рядом в maze1.world.

     Шаг решателя 1 мс, а не стандартный: у робота 52 вращательных
     шарнира и 48 отдельных тел роликов, каждое из которых касается пола
     по очереди. На более крупном шаге контакт ролика успевает пройти
     насквозь, и колесо начинает подрагивать. -->
<sdf version="1.9">
  <world name="flat">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction>
              <!-- Бетон под резиновым роликом. Меканум боком едет только
                   за счёт того, что ролики свободно катятся ПОПЕРЁК, а
                   вдоль своей оси держат: занизишь трение — робот поплывёт
                   и колёса начнут буксовать вместо качения. -->
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Метки через метр: без них на однотонном полу невозможно на глаз
         оценить, поехал ли робот боком или просто развернулся. -->
    <model name="grid_marks">
      <static>true</static>
      <link name="link">
        <visual name="m_-5_-5">
          <pose>-5.0 -5.0 0.002 0 0 0</pose>
          <geometry><box><size>0.10 0.10 0.004</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
