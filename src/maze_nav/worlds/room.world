<?xml version="1.0" ?>
<!-- СГЕНЕРИРОВАНО scripts/gen_rails_world.py, руками не править. -->
<!-- Заезд на рельсы: фанера метр на метр и трубы с П-образным концом. -->
<sdf version="1.9">
  <world name="rails">
    <!-- Шаг 1 мс: у робота 48 отдельных тел роликов, и к ним
         добавился контакт бочки ролика с крутым бортом трубы. -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Пол плитками. Текстура бесшовная, но повторяется с шагом
         плитки, поэтому каждую поворачиваем случайно на 0/90/180/270°
         — иначе получается регулярный узор, а он для визуальной
         одометрии хуже, чем однотонный пол. -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <visual name="t_0_0">
          <pose>-3.000 -3.500 -0.005 0 0 3.1416</pose>
          <geometry><box><size>2.0 2.0 0.01</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr><metal><albedo_map>model://maze_nav/meshes/floor.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
        <visual name="t_0_1">
          <pose>-3.000 -1.500 -0.005 0 0 1.5708</pose>
          <geometry><box><size>2.0 2.0 0.01</size></box></geometry>
