    <!-- Стены. Текстура на них мельче и бледнее пола: яркая стена
         даёт слишком жирные признаки, и одометрия в симуляторе
         выглядела бы лучше, чем окажется на железе. -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="w0_collision">
          <pose>3.000 4.500 1.250 0 0 0</pose>
          <geometry><box><size>14.100 0.100 2.5</size></box></geometry>
        </collision>
        <visual name="w0_visual">
          <pose>3.000 4.500 1.250 0 0 0</pose>
          <geometry><box><size>14.100 0.100 2.5</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse>
