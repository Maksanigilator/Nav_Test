    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rl_roller_0">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rl_roller_1">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rl_roller_2">
    <mu1>1.0</mu1><mu2>1.0</mu2>
