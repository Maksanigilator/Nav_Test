    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rr_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.2</mu1><mu2>0.2</mu2>
  </gazebo>


  <!-- Кронштейн: от профиля крыши ВПЕРЁД, горизонтально.
       Наклон живёт отдельно, в camera_link, чтобы менять его одной
       константой, не трогая вынос. -->
  <link name="camera_mount_link">
    <visual><origin xyz="-0.0500 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.012" length="0.1"/></geometry>
      <material name="hub"/></visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/><child link="camera_mount_link"/>
    <origin xyz="0.5000 0.0 0.6147"/>
  </joint>

  <!-- D435, наклон 30° вниз -->
  <link name="camera_link">
    <visual><geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="hub"/></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/><child link="camera_link"/>
    <origin rpy="0 0.523599 0"/>
  </joint>
  <!-- Оптический кадр: z вперёд, x вправо, y вниз — как принято в ROS.
       Именно его имя должно стоять в gz_frame_id ниже, иначе Gazebo
       проштампует снимки составным именем вида model/link/sensor,
       которого нет в TF, и SLAM молча развалится. -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_depth_optical_frame"/>
    <origin rpy="-1.570796 0 -1.570796"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="d435" type="rgbd_camera">
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <topic>camera</topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.518436</horizontal_fov>
        <image><width>640</width><height>480</height>
          <format>R8G8B8</format></image>
        <clip><near>0.28</near><far>10.0</far></clip>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <!-- Стоит в начале base_link: центр колёсной базы на высоте оси.
       Место выбрано не для удобства. Гироскоп от положения не
       зависит вовсе — угловая скорость у твёрдого тела одинакова
       везде. А вот акселерометр, смещённый на r от центра вращения,
       ловит при повороте центростремительное w^2*r и тангенциальное
       a*r. При r=0.5 м и w=0.5 рад/с это 0.125 м/с2 — вектор
       гравитации наклоняется на 0.7°, а из него берутся крен и
       тангаж. robot_localization поворачивает данные по TF, но
       вынос плеча НЕ компенсирует, так что одним объявлением
       положения тут не отделаться.
       Нам крен нужен чистым: по нему отличается правильная посадка
       на дорожку качения от заезда на галтель. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
</robot>
