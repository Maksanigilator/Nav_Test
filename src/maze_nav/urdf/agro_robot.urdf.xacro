<?xml version="1.0"?>
<!-- СГЕНЕРИРОВАНО scripts/gen_robot_urdf.py — руками не править.
     Геометрия колёс прочитана из CAD-модели, а не выведена формулой:
     положения и оси роликов взяты как есть, включая направление
     наклона для каждого колеса. Пересобрать после изменения модели. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agro_robot">

  <material name="chassis"><color rgba="0.22 0.23 0.25 1"/></material>
  <material name="hub"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="roller"><color rgba="0.38 0.39 0.42 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.1014"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.22"/>
      <mass value="100.000"/>
      <inertia ixx="11.0" iyy="16.6" izz="18.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1035" rpy="0 0 -1.570796"/>
      <geometry><mesh filename="package://maze_nav/meshes/chassis.stl"
              scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <!-- Коллизия примитивом: меш в 680 тыс. граней убил бы физику -->
    <collision>
      <origin xyz="0 0 0.319"/>
      <geometry><box size="1.2016 0.9228 0.6375"/></geometry>
    </collision>
  </link>

  <!-- колесо fl: CAD плоскость X=-355.4, ось Y=317.8, кольцо роликов R=86.0 мм -->
  <link name="fl_wheel">
    <inertial>
      <mass value="4.520"/>
      <inertia ixx="0.013210" iyy="0.023237" izz="0.013210" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- Визуал — геометрия узла из CAD как есть: ступица, диски
         и рельсовый ролик с настоящим профилем. Меш уже развёрнут
         в систему звена при извлечении, поправок не нужно.
         Ролики меканума сюда НЕ входят: они вращаются отдельно. -->
    <visual><geometry><mesh
      filename="package://maze_nav/meshes/wheel_hub_l.stl"
      scale="0.001 0.001 0.001"/></geometry>
      <material name="hub"/></visual>
    <!-- Коллизия рельсового ролика: набор цилиндров по измеренному
         профилю (см. RAIL_PROFILE). Канавка вогнутая, одним телом
         её не посчитать — движки берут только выпуклые формы. -->
    <collision><!-- R=50.0 мм -->
      <origin xyz="0 -0.0849 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.05" length="0.0399"/></geometry>
    </collision>
    <collision><!-- R=52.0 мм -->
      <origin xyz="0 -0.0625 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.052" length="0.0050"/></geometry>
    </collision>
    <collision><!-- R=55.0 мм -->
      <origin xyz="0 -0.0580 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.055" length="0.0040"/></geometry>
    </collision>
    <collision><!-- R=58.0 мм -->
      <origin xyz="0 -0.0545 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.058" length="0.0030"/></geometry>
    </collision>
    <collision><!-- R=62.0 мм -->
      <origin xyz="0 -0.0515 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.062" length="0.0030"/></geometry>
    </collision>
    <collision><!-- R=68.0 мм -->
      <origin xyz="0 -0.0485 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.068" length="0.0030"/></geometry>
    </collision>
    <collision><!-- R=75.0 мм -->
      <origin xyz="0 -0.0435 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.075" length="0.0071"/></geometry>
    </collision>
  </link>
  <joint name="fl_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="fl_wheel"/>
    <origin xyz="0.3178 0.3554 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <link name="fl_roller_0">
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="0.00001647" iyy="0.00001647" izz="0.00000477" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><mesh filename="package://maze_nav/meshes/mec_roller.stl" scale="0.001 0.001 0.001"/></geometry><material name="roller"/></visual>
    <collision><geometry><mesh filename="package://maze_nav/meshes/mec_roller.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
