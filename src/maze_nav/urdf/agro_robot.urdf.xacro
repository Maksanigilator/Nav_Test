    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="fl_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="fr_roller_0">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
