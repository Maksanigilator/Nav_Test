# Заезд на рельсы с произвольной точки настила.
#
# Предусловие: робот стоит где угодно на настиле, а детектор хотя бы раз
# видел рельсы — поза берётся из накопленного слоя, а не из текущего кадра,
# поэтому смотреть на рельсы в момент вызова не обязательно.
#
# Ноль в любом числовом поле означает «взять умолчание из параметра узла».
# Так вызов без аргументов остаётся осмысленным.

bool    scan             # сделать оборот на месте перед поиском
float32 drive_distance   # сколько проехать по трубам, м
int32   retries          # сколько попыток выверки и заезда
---
bool    success
string  reason           # «заехали с попытки 1», «упёрлись», «увело на 11°»
float32 gone             # сколько в итоге прошли по трубам, м
---
string  phase            # ОСМОТР / ПОИСК / ПОДХОД / ВЫВЕРКА / ЗАЕЗД / ОТКАТ
string  detail           # та же строка, что уходит в журнал
int32   attempt
float32 gone
float32 need
float32 lateral          # поперечное смещение от оси рельсов, м
float32 yaw_error        # курсовая ошибка, рад
