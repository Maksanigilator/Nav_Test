# Артефакты colcon. У нас они живут в именованных томах Docker,
# но если когда-нибудь соберёшь на хосте — не попадут в репозиторий.
build/
install/
log/

# Python
__pycache__/
*.pyc

# Локальные настройки Gazebo (classic — .gazebo, Harmonic — .gz)
.gazebo/
.gz/

# IDE и мусор редакторов
.vscode/
.idea/
*.swp
*~

# Датасеты — гигабайты, в git им не место. На main они не нужны; правило
# стоит здесь, потому что каталог лежит на дисках у всех веток сразу.
datasets/

# Исходная CAD-модель робота (STEP, ~65 МБ). Нужна только чтобы ПЕРЕСОБРАТЬ
# меши — лежит на диске у того, кто этим занимается, в git не кладём.
# Пересборка меша и описания робота — в ветке agrobot.
*.step
*.STEP
